{
  "name": "hozwei/codeserver-layer",
  "description": "Nextcloud app that opens files in code-server",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/hozwei/nextcloud-codeserver-layer",
  "support": {
    "issues": "https://github.com/hozwei/nextcloud-codeserver-layer/issues",

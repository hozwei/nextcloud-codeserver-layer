#
# Settings for compose.example.yaml. Copy this file to .env next to it, fill in your values and
# keep it private (chmod 600): it holds two passwords and two secrets. docs/hosting.md explains
# each value. No quotes around values.

# code-server's address as the browser opens it, without a slash at the end. Your reverse proxy
# serves it over HTTPS and forwards it to CODE_PORT on this host. Docker opens that port on every
# interface, past a firewall such as ufw; everything behind it still needs the sign-in
# (docs/hosting.md, "Reverse proxy").
CODE_URL=https://code.example.com
CODE_PORT=8080

# The user and group id that own the working copy. code-server and the sync client run as them,
# and both folders below must belong to them.
CODE_UID=1000
CODE_GID=1000

# Folders on this host: the working copy (in the containers: /workspace) and code-server's home
# (settings, extensions, unsaved editors).
CODE_WORKSPACE_DIR=/srv/code-server/workspace
CODE_HOME_DIR=/srv/code-server/home

# The Nextcloud folder that the working copy mirrors (create it first), and the account it belongs
# to. The address may be an internal one that Nextcloud accepts (trusted_domains): an http://
# address, or an https:// one whose certificate is valid for that name.
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=alice
NEXTCLOUD_FOLDER=/Projects
# An app password of that account (Personal settings > Security > Devices & sessions).
NEXTCLOUD_APP_PASSWORD=
# Seconds between two syncs.
SYNC_INTERVAL=30

# The sign-in with Nextcloud's app oidc. The issuer exactly as Nextcloud's
# /.well-known/openid-configuration states it; the client as `occ oidc:create` printed it.
OIDC_ISSUER_URL=https://cloud.example.com
OIDC_CLIENT_ID=code-example-com-oauth2-proxy-gate
OIDC_CLIENT_SECRET=
# 32 random bytes, Base64 for URLs: openssl rand -base64 32 | tr -- '+/' '-_'
OIDC_COOKIE_SECRET=

TZ=Etc/UTC
